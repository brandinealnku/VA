rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function requestOwner() { return request.resource.data.ownerId == request.auth.uid; }
    function resourceOwner() { return resource.data.ownerId == request.auth.uid; }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /workspaces/{workspaceId} {
      allow create: if signedIn() && requestOwner();
      allow read, update, delete: if signedIn() && resourceOwner();

      match /documents/{documentId} {
        allow create: if signedIn() && requestOwner();
        allow read, update, delete: if signedIn() && resourceOwner();

        match /documentChunks/{chunkId} {
          allow read: if signedIn() && resourceOwner();
          allow write: if false; // Cloud Functions (admin SDK) writes chunks.
        }
      }

      match /queries/{queryId} {
        allow create: if signedIn() && requestOwner();
        allow read, update, delete: if signedIn() && resourceOwner();
      }

      match /chatSessions/{sessionId}/{document=**} {
        allow read, write: if signedIn();
      }
    }
  }
}
